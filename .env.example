# LLM Provider API Keys
# NOTE: API keys are primarily configured via the in-app Provider Setup UI
# and stored in browser localStorage. These env vars are optional fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LOGOS Configuration
LOGOS_SPEC_PATH=./vendor/LOGOS-SPEC
STORY_PACKAGES_PATH=./story-packages

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
